# Example AppDaemon secrets.
# Copy this file to appdaemon/secrets.yaml (WITHOUT the .example suffix) and
# replace the values with your real OVH keys.
#
# ⚠️ NEVER commit your real secrets.yaml to a public repository.
#
# Generate the three values at once at:
#   https://api.ovh.com/createToken/
# with rights:  GET /sms/*   and   POST /sms/*

ovh_application_key: "your_application_key"
ovh_application_secret: "your_application_secret"
ovh_consumer_key: "your_consumer_key"
